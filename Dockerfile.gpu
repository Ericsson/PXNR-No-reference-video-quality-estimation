# syntax=docker/dockerfile:1
#
# GPU build for PXNR (NVIDIA / CUDA, linux/amd64 only).
#
# Unlike the portable CPU Dockerfile, this installs `tensorflow[and-cuda]`
# (via requirements-gpu.txt), which bundles the CUDA and cuDNN runtime
# libraries as pip wheels. The only host requirement is a recent NVIDIA driver
# plus the NVIDIA Container Toolkit, so that `docker run --gpus all` injects the
# driver into the container. No system CUDA toolkit is needed in the image.
#
# Build:  ./build.sh gpu
# Run:    docker run --rm --gpus all -v "$PWD/data:/data" pxnr:gpu /data/clip_30hz.mp4
#
# This extra has no arm64 build, so this image is amd64-only (the CPU
# Dockerfile remains the multi-arch / Apple-Silicon path).
FROM python:3.12-slim

# Cap glibc malloc arenas (see the CPU Dockerfile for rationale). Harmless on
# GPU runs; keeps host-side RSS down.
ENV MALLOC_ARENA_MAX=2

# ffmpeg + ffprobe (BtbN static GPL build, amd64). libgomp1 is the OpenMP
# runtime for the TensorFlow wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget xz-utils ca-certificates p7zip-full libgomp1 && \
    wget -q -O /tmp/ffmpeg.tar.xz \
        "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz" && \
    mkdir -p /opt/ffmpeg && \
    tar xf /tmp/ffmpeg.tar.xz -C /opt/ffmpeg --strip-components=1 && \
    ln -s /opt/ffmpeg/bin/ffmpeg  /usr/local/bin/ffmpeg && \
    ln -s /opt/ffmpeg/bin/ffprobe /usr/local/bin/ffprobe && \
    rm /tmp/ffmpeg.tar.xz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir /resources/
COPY ./requirements-gpu.txt /resources/requirements-gpu.txt
RUN python3 -m pip install --no-cache-dir -r /resources/requirements-gpu.txt

COPY *.py /resources/
COPY ./model_coefficients /resources/model_coefficients

# Unpack the split 7-Zip image-model archive and drop the parts.
RUN cd /resources/model_coefficients && \
    7z x image_model.h5.7z.001 && \
    rm -f image_model.h5.7z.*

WORKDIR /resources/

# Same single-purpose CLI as the CPU image: pass the input video as a positional
# argument. The predicted MOS is printed as JSON on stdout, diagnostics on stderr.
#   docker run --rm --gpus all -v "$PWD/clip.mp4:/data/in.mp4" pxnr:gpu /data/in.mp4
ENTRYPOINT ["python3", "/resources/PXNR-model.py"]
