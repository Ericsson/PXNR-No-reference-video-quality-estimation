FROM tensorflow/tensorflow:2.18.0

RUN mkdir /opt/ffmpeg/
COPY ffmpeg-git-amd64-static.tar.xz /opt/ffmpeg/
WORKDIR /opt/ffmpeg/
RUN tar xvf ffmpeg*.xz
#WORKDIR /opt/ffmpeg/ffmpeg-7.1
RUN ln -s "/opt/ffmpeg/ffmpeg-git-20240629-amd64-static/ffmpeg" /usr/local/bin/
RUN ln -s "/opt/ffmpeg/ffmpeg-git-20240629-amd64-static/ffprobe" /usr/local/bin/

RUN mkdir /resources/
COPY ./new_requirements.txt /resources/requirements.txt
RUN python3 -m pip install -r /resources/requirements.txt
#RUN apt-get update

COPY *.py /resources/ 
COPY ./model_coefficients /resources/model_coefficients

WORKDIR /resources/

