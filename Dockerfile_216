FROM tensorflow/tensorflow:2.18.0
RUN mkdir -p /opt/ffmpeg/
WORKDIR /opt/ffmpeg/

RUN apt-get update && apt-get install -y wget xz-utils && \
    wget https://johnvansickle.com/ffmpeg/builds/ffmpeg-git-amd64-static.tar.xz && \
    tar xvf ffmpeg-git-amd64-static.tar.xz && \
    ln -s /opt/ffmpeg/ffmpeg-git-*-amd64-static/ffmpeg /usr/local/bin/ffmpeg && \
    ln -s /opt/ffmpeg/ffmpeg-git-*-amd64-static/ffprobe /usr/local/bin/ffprobe && \
    rm ffmpeg-git-amd64-static.tar.xz && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN mkdir /resources/
COPY ./new_requirements.txt /resources/requirements.txt
RUN python3 -m pip install -r /resources/requirements.txt

COPY *.py /resources/ 
COPY ./model_coefficients /resources/model_coefficients

WORKDIR /resources/

